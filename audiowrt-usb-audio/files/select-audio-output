#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

output_type="$(uci -q get audiowrt-audio.main.output_type || echo auto)"
[ "$output_type" = 'bluetooth' ] && exit 0

card=""
if [ -r /proc/asound/cards ]; then
	card="$(awk '
		/USB-Audio/ {
			line=$0
			sub(/^[[:space:]]*/, "", line)
			split(line, fields, /[[:space:]]+/)
			print fields[1]
			exit
		}
	' /proc/asound/cards)"
fi

if [ -z "$card" ]; then
	uci -q set audiowrt-audio.main.ready='0'
	uci -q set audiowrt-audio.main.device=''
	uci -q set audiowrt-audio.main.card=''
	uci -q set audiowrt-audio.main.pcm=''
	uci -q set audiowrt-audio.main.last_error='No USB audio playback device detected.'
	uci -q commit audiowrt-audio
	rm -f /etc/asound.conf
	logger -t audiowrt-audio "No USB audio playback device detected"
	exit 0
fi

pcm=""
if [ -r /proc/asound/pcm ]; then
	pcm="$(awk -v card="$card" '
		$0 ~ "^[[:space:]]*" card "-[0-9][0-9]:" && /playback/ {
			line=$0
			sub(/^[[:space:]]*/, "", line)
			split(line, parts, /[-:]/)
			print parts[2] + 0
			exit
		}
	' /proc/asound/pcm)"
fi
[ -n "$pcm" ] || pcm="0"

cat > /etc/asound.conf <<EOF
pcm.audiowrt_dmix {
	type dmix
	ipc_key 2468
	ipc_perm 0666
	slave {
		pcm "hw:${card},${pcm}"
		rate 44100
	}
}

pcm.!default {
	type plug
	slave.pcm "audiowrt_dmix"
}

ctl.!default {
	type hw
	card ${card}
}
EOF

uci -q set audiowrt-audio.main.output_type='usb'
uci -q set audiowrt-audio.main.ready='1'
uci -q set audiowrt-audio.main.device='default'
uci -q set audiowrt-audio.main.card="$card"
uci -q set audiowrt-audio.main.pcm="$pcm"
uci -q set audiowrt-audio.main.bluetooth_device=''
uci -q set audiowrt-audio.main.bluetooth_name=''
uci -q set audiowrt-audio.main.last_error=''
uci -q commit audiowrt-audio

logger -t audiowrt-audio "Selected USB audio card ${card}, PCM ${pcm}"

for service in mpd shairport-sync librespot; do
	[ -x "/etc/init.d/$service" ] || continue
	"/etc/init.d/$service" restart >/dev/null 2>&1 || true
done
