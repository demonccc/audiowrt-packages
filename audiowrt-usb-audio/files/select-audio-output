#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

RUNTIME_DIR=/tmp/audiowrt
STATE_FILE="$RUNTIME_DIR/audio.state"
ASOUND_FILE="$RUNTIME_DIR/asound.conf"

state_value() {
	key="$1"
	[ -r "$STATE_FILE" ] || return 0
	sed -n "s/^$key=//p" "$STATE_FILE" | head -n 1
}

write_state() {
	ready="$1"
	card="$2"
	pcm="$3"
	error="$4"
	mkdir -p "$RUNTIME_DIR"
	tmp="$STATE_FILE.$$"
	{
		printf 'output_type=usb\n'
		printf 'ready=%s\n' "$ready"
		printf 'device=default\n'
		printf 'card=%s\n' "$card"
		printf 'pcm=%s\n' "$pcm"
		printf 'bluetooth_device=\n'
		printf 'bluetooth_name=\n'
		printf 'last_error=%s\n' "$error"
	} > "$tmp"
	mv -f "$tmp" "$STATE_FILE"
}

current_output="$(state_value output_type || true)"
[ "$current_output" = 'bluetooth' ] && exit 0

card=""
if [ -r /proc/asound/cards ]; then
	card="$(awk '
		/USB-Audio/ {
			line=$0
			sub(/^[[:space:]]*/, "", line)
			split(line, fields, /[[:space:]]+/)
			print fields[1]
			exit
		}
	' /proc/asound/cards)"
fi

if [ -z "$card" ]; then
	if [ -z "$current_output" ] || [ "$current_output" = 'usb' ]; then
		write_state 0 "" "" "No USB audio playback device detected."
		rm -f "$ASOUND_FILE"
	fi
	logger -t audiowrt-audio "No USB audio playback device detected"
	exit 0
fi

pcm=""
if [ -r /proc/asound/pcm ]; then
	pcm="$(awk -v card="$card" '
		$0 ~ "^[[:space:]]*" card "-[0-9][0-9]:" && /playback/ {
			line=$0
			sub(/^[[:space:]]*/, "", line)
			split(line, parts, /[-:]/)
			print parts[2] + 0
			exit
		}
	' /proc/asound/pcm)"
fi
[ -n "$pcm" ] || pcm="0"

mkdir -p "$RUNTIME_DIR"
cat > "$ASOUND_FILE" <<EOF
pcm.audiowrt_dmix {
	type dmix
	ipc_key 2468
	ipc_perm 0666
	slave {
		pcm "hw:${card},${pcm}"
		rate 44100
	}
}

pcm.!default {
	type plug
	slave.pcm "audiowrt_dmix"
}

ctl.!default {
	type hw
	card ${card}
}
EOF

write_state 1 "$card" "$pcm" ""
logger -t audiowrt-audio "Selected USB audio card ${card}, PCM ${pcm}"

for service in mpd shairport-sync librespot; do
	[ -x "/etc/init.d/$service" ] || continue
	"/etc/init.d/$service" restart >/dev/null 2>&1 || true
done
