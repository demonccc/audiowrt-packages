#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
. /usr/libexec/audiowrt/config-save
package="$1"; section="$2"; settings="$3"
save_begin "$package"
save_uci get "$package.$section" >/dev/null || save_uci set "$package.$section=$package"
while IFS='=' read -r key value; do
	[ -n "$key" ] || continue
	if [ "$key" = name ]; then
		current=$(save_uci get "$package.$section.name" || true)
		case "$current" in ''|'Shairport-Sync-%v-%h'|%H) ;; *) continue ;; esac
	fi
	save_uci set "$package.$section.$key=$value"
done < "$settings"
save_finish
