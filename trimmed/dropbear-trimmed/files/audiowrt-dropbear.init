#!/bin/sh /etc/rc.common

START=19
STOP=50
USE_PROCD=1
PROG=/usr/sbin/dropbear
KEY=/etc/dropbear/dropbear_ed25519_host_key

start_instance() {
	local section="$1"
	local enable port password_auth root_password_auth

	config_get_bool enable "$section" enable 1
	[ "$enable" -eq 1 ] || return 0

	config_get port "$section" Port 22
	config_get password_auth "$section" PasswordAuth on
	config_get root_password_auth "$section" RootPasswordAuth on

	mkdir -p /etc/dropbear
	[ -s "$KEY" ] || /usr/bin/dropbearkey -t ed25519 -f "$KEY" >/dev/null 2>&1

	procd_open_instance "$section"
	procd_set_param command "$PROG" -F -E -r "$KEY" -p "$port"
	[ "$password_auth" = "off" ] && procd_append_param command -s
	[ "$root_password_auth" = "off" ] && procd_append_param command -g
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	config_load dropbear
	config_foreach start_instance dropbear
}

service_triggers() {
	procd_add_reload_trigger dropbear
}
