#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

[ "$(uci -q get audiowrt.main.identity_initialized || echo 0)" = '1' ] && exit 0

# Keep the factory hostname deterministic. The provisioning SSID owns the
# per-device MAC suffix; the host name intentionally stays simple so the
# first-use address is always audiowrt.local.
name='audiowrt'

uci -q set system.@system[0].hostname="$name" 2>/dev/null || true
uci -q set audiowrt.main.identity_initialized='1'
uci -q commit system 2>/dev/null || true
uci -q commit audiowrt

# Minimal AudioWRT BusyBox builds do not need the hostname applet. Update the
# running kernel hostname directly so mDNS sees the factory identity without a
# reboot.
if [ -w /proc/sys/kernel/hostname ]; then
	printf '%s\n' "$name" > /proc/sys/kernel/hostname
fi

if [ -x /usr/sbin/audiowrt-wifi-client ]; then
	/usr/sbin/audiowrt-wifi-client mdns-sync >/dev/null 2>&1 || true
elif [ -x /etc/init.d/audiowrt-renderer ]; then
	/etc/init.d/audiowrt-renderer reload >/dev/null 2>&1 || true
elif [ -x /etc/init.d/umdns ]; then
	/etc/init.d/umdns restart >/dev/null 2>&1 || true
fi
exit 0
