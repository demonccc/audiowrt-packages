#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

setup_ip() {
	uci -q get audiowrt.main.setup_ip || echo "192.168.77.1"
}

sync_core_storage() {
	[ -x /usr/sbin/audiowrt-storage ] || return 0
	/usr/sbin/audiowrt-storage sync-core >/dev/null 2>&1 || true
}

setup_dns_enable() {
	ip="$(setup_ip)"
	uci -q del_list dhcp.@dnsmasq[0].address="/#/$ip" 2>/dev/null || true
	uci -q add_list dhcp.@dnsmasq[0].address="/#/$ip"
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
}

setup_dns_disable() {
	ip="$(setup_ip)"
	uci -q del_list dhcp.@dnsmasq[0].address="/#/$ip" 2>/dev/null || true
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
}

first_radio() {
	uci -q show wireless 2>/dev/null |
		sed -n "s/^wireless\.\([^.=]*\)=wifi-device.*/\1/p" |
		head -n 1
}

sync_identity() {
	name="$(uci -q get audiowrt.main.device_name || echo AudioWRT)"
	uci -q set system.@system[0].hostname="$name"
	uci -q commit system

	if uci -q get shairport-sync.shairport_sync >/dev/null 2>&1; then
		uci -q set shairport-sync.shairport_sync.name="$name"
		uci -q commit shairport-sync
		/etc/init.d/shairport-sync restart >/dev/null 2>&1 || true
	fi

	sync_core_storage
}

provisioning_start() {
	radio="$(first_radio)"
	[ -n "$radio" ] || {
		echo "ERROR: no Wi-Fi radio is available." >&2
		exit 3
	}

	if uci -q get wireless.audiowrt_client >/dev/null 2>&1; then
		uci -q set wireless.audiowrt_client.disabled='1'
	fi

	uci -q set wireless.audiowrt_setup.disabled='0'
	uci -q set wireless."$radio".disabled='0'
	uci -q set audiowrt.main.provisioning='1'
	uci -q set audiowrt.main.last_error=''
	uci -q commit wireless
	uci -q commit audiowrt

	setup_dns_enable
	wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
	logger -t audiowrt "Provisioning mode enabled"
}

provisioning_stop() {
	uci -q set wireless.audiowrt_setup.disabled='1'
	uci -q set audiowrt.main.provisioning='0'
	uci -q commit wireless
	uci -q commit audiowrt
	setup_dns_disable
	wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
	sync_core_storage
}

status() {
	name="$(uci -q get audiowrt.main.device_name || echo AudioWRT)"
	provisioning="$(uci -q get audiowrt.main.provisioning || echo 1)"
	audio_ready="$(uci -q get audiowrt.main.audio_ready || echo 0)"
	audio_device="$(uci -q get audiowrt.main.audio_device || true)"
	wifi_ssid="$(uci -q get audiowrt.main.wifi_ssid || true)"
	last_error="$(uci -q get audiowrt.main.last_error || true)"

	printf 'device_name=%s\n' "$name"
	printf 'provisioning=%s\n' "$provisioning"
	printf 'audio_ready=%s\n' "$audio_ready"
	printf 'audio_device=%s\n' "$audio_device"
	printf 'wifi_ssid=%s\n' "$wifi_ssid"
	printf 'last_error=%s\n' "$last_error"
}

case "${1:-}" in
	status)
		status
		;;
	identity)
		[ "${2:-}" = "sync" ] || {
			echo "Usage: audiowrtctl identity sync" >&2
			exit 2
		}
		sync_identity
		;;
	provisioning)
		case "${2:-}" in
			start) provisioning_start ;;
			stop) provisioning_stop ;;
			*)
				echo "Usage: audiowrtctl provisioning {start|stop}" >&2
				exit 2
				;;
		esac
		;;
	*)
		echo "Usage: audiowrtctl {status|identity sync|provisioning start|provisioning stop}" >&2
		exit 2
		;;
esac
