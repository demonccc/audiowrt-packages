#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

[ "${ACTION:-}" = "released" ] || exit 0

case "${BUTTON:-}" in
	wps|wps_button|wps-*|wps_*) ;;
	*) exit 0 ;;
esac

seen="${SEEN:-0}"
case "$seen" in
	''|*[!0-9]*) exit 0 ;;
esac

[ "$seen" -ge 5 ] || exit 0
/usr/sbin/audiowrtctl provisioning start >/dev/null 2>&1 &
