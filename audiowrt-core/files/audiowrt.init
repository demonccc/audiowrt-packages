#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=95
USE_PROCD=1

start_service() {
	config_load audiowrt
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	logger -t audiowrt "AudioWRT core initialized"
}

service_triggers() {
	procd_add_reload_trigger audiowrt
}
