#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

ssid="${1:-}"
encryption="${2:-sae-mixed}"
key="${3:-}"

[ -n "$ssid" ] || {
	logger -t audiowrt "Provisioning rejected: empty SSID"
	exit 2
}

[ "$(uci -q get audiowrt.main.provisioning || echo 0)" = "1" ] || {
	logger -t audiowrt "Provisioning rejected: device is already provisioned"
	exit 3
}

case "$encryption" in
	none)
		key=""
		;;
	psk2|sae|sae-mixed)
		[ "${#key}" -ge 8 ] || {
			uci -q set audiowrt.main.last_error='Wi-Fi password must contain at least 8 characters.'
			uci -q commit audiowrt
			exit 4
		}
		;;
	*)
		uci -q set audiowrt.main.last_error='Unsupported Wi-Fi security mode.'
		uci -q commit audiowrt
		exit 5
		;;
esac

radio="$(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device.*/\1/p" | head -n 1)"
[ -n "$radio" ] || {
	uci -q set audiowrt.main.last_error='No Wi-Fi radio is available.'
	uci -q commit audiowrt
	exit 6
}

setup_ip="$(uci -q get audiowrt.main.setup_ip || echo 192.168.77.1)"
timeout="$(uci -q get audiowrt.main.setup_timeout || echo 45)"

uci -q delete network.audiowrt_wifi 2>/dev/null || true
uci -q set network.audiowrt_wifi='interface'
uci -q set network.audiowrt_wifi.proto='dhcp'

uci -q delete wireless.audiowrt_client 2>/dev/null || true
uci -q set wireless.audiowrt_client='wifi-iface'
uci -q set wireless.audiowrt_client.device="$radio"
uci -q set wireless.audiowrt_client.mode='sta'
uci -q set wireless.audiowrt_client.network='audiowrt_wifi'
uci -q set wireless.audiowrt_client.ssid="$ssid"
uci -q set wireless.audiowrt_client.encryption="$encryption"
uci -q set wireless.audiowrt_client.disabled='0'
[ "$encryption" = "none" ] || uci -q set wireless.audiowrt_client.key="$key"

uci -q set wireless.audiowrt_setup.disabled='1'
uci -q del_list dhcp.@dnsmasq[0].address="/#/$setup_ip" 2>/dev/null || true
uci -q set audiowrt.main.last_error=''

uci -q commit network
uci -q commit wireless
uci -q commit dhcp
uci -q commit audiowrt

/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true

elapsed=0
connected=0
while [ "$elapsed" -lt "$timeout" ]; do
	status="$(ubus call network.interface.audiowrt_wifi status 2>/dev/null || true)"
	if printf '%s\n' "$status" | grep -q '"up":[[:space:]]*true'; then
		connected=1
		break
	fi
	sleep 2
	elapsed=$((elapsed + 2))
done

if [ "$connected" -eq 1 ]; then
	uci -q set audiowrt.main.provisioning='0'
	uci -q set audiowrt.main.wifi_ssid="$ssid"
	uci -q set audiowrt.main.last_error=''
	uci -q commit audiowrt
	logger -t audiowrt "Wi-Fi provisioning completed for SSID $ssid"
	exit 0
fi

# Restore the setup AP if the client connection failed.
uci -q set wireless.audiowrt_client.disabled='1'
uci -q set wireless.audiowrt_setup.disabled='0'
uci -q add_list dhcp.@dnsmasq[0].address="/#/$setup_ip"
uci -q set audiowrt.main.provisioning='1'
uci -q set audiowrt.main.last_error='Could not connect to the selected Wi-Fi network. Check the SSID and password.'
uci -q commit wireless
uci -q commit dhcp
uci -q commit audiowrt
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
logger -t audiowrt "Wi-Fi provisioning failed for SSID $ssid"
exit 7
