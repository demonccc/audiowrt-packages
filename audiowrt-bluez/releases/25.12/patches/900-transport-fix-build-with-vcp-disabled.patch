From c6dcf6b714501768ab7ea293e75d945be0eec188 Mon Sep 17 00:00:00 2001
From: Bastien Nocera <hadess@hadess.net>
Date: Tue, 16 Sep 2025 23:00:14 +0000
Subject: [PATCH] transport: Fix build with VCP support disabled

Backport the transport.c part of upstream BlueZ commit
c6dcf6b714501768ab7ea293e75d945be0eec188.

BlueZ 5.83 references bt_audio_vcp_get_volume() and
bt_audio_vcp_set_volume() from the BAP transport even when VCP is disabled,
which causes the minimal AudioWRT build to fail at link time. AudioWRT always
builds this package with --disable-vcp, so guard the calls exactly as upstream
later did. The configure.ac HAVE_VCP definition from the upstream commit is not
needed for this disabled-only package configuration.

--- a/profiles/audio/transport.c
+++ b/profiles/audio/transport.c
@@ -2263,16 +2263,24 @@ static void bap_connecting(struct bt_bap_stream *stream, bool state, int fd,
 
 static int transport_bap_get_volume(struct media_transport *transport)
 {
+#ifdef HAVE_VCP
 	return bt_audio_vcp_get_volume(transport->device);
+#else
+	return -ENODEV;
+#endif /* HAVE_VCP */
 }
 
 static int transport_bap_set_volume(struct media_transport *transport,
 								int volume)
 {
+#ifdef HAVE_VCP
 	if (volume < 0 || volume > 255)
 		return -EINVAL;
 
 	return bt_audio_vcp_set_volume(transport->device, volume) ? 0 : -EIO;
+#else
+	return -ENODEV;
+#endif /* HAVE_VCP */
 }
 
 static void transport_bap_destroy(void *data)
