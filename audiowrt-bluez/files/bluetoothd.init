#!/bin/sh /etc/rc.common

USE_PROCD=1
START=60
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/bluetoothd -n
	[ -f /etc/bluetooth/main.conf ] && procd_append_param command -f /etc/bluetooth/main.conf
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger bluetooth
}
