{
	"luci-app-audiowrt-wifi-client": {
		"description": "Grant access to the AudioWRT Wi-Fi client manager",
		"read": {
			"uci": [ "wireless", "network", "system" ],
			"file": { "/usr/sbin/audiowrt-wifi-client": [ "exec" ] }
		},
		"write": {
			"uci": [ "wireless", "network" ],
			"file": { "/usr/sbin/audiowrt-wifi-client": [ "exec" ] }
		}
	}
}
