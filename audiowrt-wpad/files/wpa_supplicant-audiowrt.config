# AudioWRT station side of the multicall wpad binary.
# Client-only WPA2/WPA3 Personal for netifd.

CONFIG_DRIVER_NL80211=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y

CONFIG_NO_STDOUT_DEBUG=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON

CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CONFIG_ELOOP_EPOLL=y
CONFIG_NO_LINUX_PACKET_SOCKET_WAR=y

# WPA3-Personal requires SAE and PMF/802.11w.
CONFIG_IEEE80211W=y
CONFIG_SAE=y

# Reuse the official OpenWrt mbedTLS runtime selected by the distribution.
CONFIG_TLS=mbedtls

# OpenWrt netifd/wifi-scripts integration.
CONFIG_UBUS=y
