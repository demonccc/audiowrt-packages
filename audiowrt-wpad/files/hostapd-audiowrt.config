# AudioWRT provisioning AP side of the multicall wpad binary.
# The setup network is intentionally open and runs only during provisioning.

CONFIG_DRIVER_NL80211=y

# Keep 802.11n because constrained targets such as the TL-WDR4300 expose HT20
# in their board radio configuration. VHT/HE/EHT are deliberately omitted.
CONFIG_IEEE80211N=y

# OpenWrt radios commonly use channel=0. The provisioning AP must be able to
# select a usable channel at runtime instead of requiring a fixed channel.
CONFIG_ACS=y

# OpenWrt netifd/wifi-scripts integration.
CONFIG_UBUS=y

# /etc/init.d/wpad launches hostapd with -s and a global control socket.
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON

# Provisioning does not use enterprise authentication or router-side services.
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_RADIUS=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y

CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CONFIG_ELOOP_EPOLL=y

# Use the same crypto/TLS backend as the supplicant side so the multicall link
# can share common crypto code. No EAP/TLS server methods are enabled here.
CONFIG_TLS=mbedtls
