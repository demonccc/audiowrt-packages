#!/bin/sh /etc/rc.common

START=90

start_service() {
	[ -x /usr/sbin/udhcpd ] || return 0
	config=/tmp/audiowrt-udhcpd.conf
	[ -r "$config" ] || return 0

	stop_service

	interface="$(sed -n 's/^interface[[:space:]]\+//p' "$config" | head -n 1)"
	[ -n "$interface" ] || return 1
	ip link show "$interface" >/dev/null 2>&1 || return 1

	/usr/sbin/udhcpd -S -f "$config" >/dev/null 2>&1 &
}

stop_service() {
	killall udhcpd 2>/dev/null || true
	rm -f /var/run/audiowrt-udhcpd.pid
}

start() { start_service; }
stop() { stop_service; }
