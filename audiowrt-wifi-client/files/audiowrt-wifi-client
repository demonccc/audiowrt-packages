set -eu

usage() {
	cat <<'USAGE'
Usage:
  audiowrt-wifi-client radios
  audiowrt-wifi-client scan
  audiowrt-wifi-client status
  audiowrt-wifi-client connect <radio> <ssid> <encryption> [password] [bssid] [ip-mode] [ipaddr] [netmask] [gateway] [dns1] [dns2]
  audiowrt-wifi-client disconnect
  audiowrt-wifi-client setup-start <radio> <ssid> [setup-ip]
  audiowrt-wifi-client setup-stop
  audiowrt-wifi-client mdns-sync

Encryption values: none, psk2, sae, sae-mixed
IP modes: dhcp, static
BSSID is optional. When omitted, wpa_supplicant may roam between access points
advertising the selected SSID on the chosen radio.
Static IPv4 mode requires IP address, netmask and gateway. DNS servers are optional.
Installing this package alone does not modify OpenWrt networking.
USAGE
}

wifi_devices() {
	uci -q show wireless 2>/dev/null |
		sed -n "s/^wireless\.\([^.=]*\)=wifi-device.*/\1/p"
}

radios() {
	for radio in $(wifi_devices); do
		band="$(uci -q get wireless."$radio".band || true)"
		channel="$(uci -q get wireless."$radio".channel || true)"
		printf '%s|%s|%s\n' "$radio" "$band" "$channel"
	done
}

scan() {
	for radio in $(wifi_devices); do
		band="$(uci -q get wireless."$radio".band || true)"
		result="$(ubus call iwinfo scan "{\"device\":\"$radio\"}" 2>/dev/null || true)"
		[ -n "$result" ] || continue
		printf '%s\n' "@@RADIO:$radio|$band"
		printf '%s\n' "$result"
	done
}

status() {
	printf 'client_present=%s\n' "$(uci -q get wireless.audiowrt_client >/dev/null 2>&1 && echo 1 || echo 0)"
	printf 'client_enabled=%s\n' "$([ "$(uci -q get wireless.audiowrt_client.disabled || echo 1)" = '0' ] && echo 1 || echo 0)"
	printf 'radio=%s\n' "$(uci -q get wireless.audiowrt_client.device || true)"
	printf 'ssid=%s\n' "$(uci -q get wireless.audiowrt_client.ssid || true)"
	printf 'bssid=%s\n' "$(uci -q get wireless.audiowrt_client.bssid || true)"
	printf 'encryption=%s\n' "$(uci -q get wireless.audiowrt_client.encryption || true)"
	printf 'ip_mode=%s\n' "$(uci -q get network.audiowrt_wifi.proto || echo dhcp)"
	printf 'ipaddr=%s\n' "$(uci -q get network.audiowrt_wifi.ipaddr || true)"
	printf 'netmask=%s\n' "$(uci -q get network.audiowrt_wifi.netmask || true)"
	printf 'gateway=%s\n' "$(uci -q get network.audiowrt_wifi.gateway || true)"
	printf 'dns=%s\n' "$(uci -q get network.audiowrt_wifi.dns || true)"
	printf 'setup_enabled=%s\n' "$([ "$(uci -q get wireless.audiowrt_setup.disabled || echo 1)" = '0' ] && echo 1 || echo 0)"
	printf 'network_up=%s\n' "$(ubus call network.interface.audiowrt_wifi status 2>/dev/null | grep -q '\"up\":[[:space:]]*true' && echo 1 || echo 0)"
}

validate_encryption() {
	case "$1" in
		none|psk2|sae|sae-mixed) return 0 ;;
		*) echo "ERROR: unsupported encryption: $1" >&2; exit 4 ;;
	esac
}

validate_bssid() {
	[ -z "$1" ] || printf '%s\n' "$1" | grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'
}

validate_ipv4() {
	printf '%s\n' "$1" | awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
			}
		}
	' >/dev/null 2>&1
}

validate_netmask() {
	case "$1" in
		0.0.0.0|128.0.0.0|192.0.0.0|224.0.0.0|240.0.0.0|248.0.0.0|252.0.0.0|254.0.0.0|255.0.0.0|\
		255.128.0.0|255.192.0.0|255.224.0.0|255.240.0.0|255.248.0.0|255.252.0.0|255.254.0.0|255.255.0.0|\
		255.255.128.0|255.255.192.0|255.255.224.0|255.255.240.0|255.255.248.0|255.255.252.0|255.255.254.0|255.255.255.0|\
		255.255.255.128|255.255.255.192|255.255.255.224|255.255.255.240|255.255.255.248|255.255.255.252|255.255.255.254|255.255.255.255) return 0 ;;
		*) return 1 ;;
	esac
}

configure_ip() {
	ip_mode="${1:-dhcp}"; ipaddr="${2:-}"; netmask="${3:-}"; gateway="${4:-}"; dns1="${5:-}"; dns2="${6:-}"

	case "$ip_mode" in
		dhcp)
			uci -q set network.audiowrt_wifi.proto='dhcp'
			uci -q delete network.audiowrt_wifi.ipaddr 2>/dev/null || true
			uci -q delete network.audiowrt_wifi.netmask 2>/dev/null || true
			uci -q delete network.audiowrt_wifi.gateway 2>/dev/null || true
			uci -q delete network.audiowrt_wifi.dns 2>/dev/null || true
			;;
		static)
			validate_ipv4 "$ipaddr" || { echo 'ERROR: invalid static IPv4 address.' >&2; exit 7; }
			validate_netmask "$netmask" || { echo 'ERROR: invalid IPv4 netmask.' >&2; exit 8; }
			validate_ipv4 "$gateway" || { echo 'ERROR: invalid IPv4 gateway.' >&2; exit 9; }
			[ -z "$dns1" ] || validate_ipv4 "$dns1" || { echo 'ERROR: invalid primary DNS server.' >&2; exit 10; }
			[ -z "$dns2" ] || validate_ipv4 "$dns2" || { echo 'ERROR: invalid secondary DNS server.' >&2; exit 11; }

			uci -q set network.audiowrt_wifi.proto='static'
			uci -q set network.audiowrt_wifi.ipaddr="$ipaddr"
			uci -q set network.audiowrt_wifi.netmask="$netmask"
			uci -q set network.audiowrt_wifi.gateway="$gateway"
			uci -q delete network.audiowrt_wifi.dns 2>/dev/null || true
			[ -z "$dns1" ] || uci -q add_list network.audiowrt_wifi.dns="$dns1"
			[ -z "$dns2" ] || uci -q add_list network.audiowrt_wifi.dns="$dns2"
			;;
		*)
			echo "ERROR: unsupported IP mode: $ip_mode" >&2
			exit 12
			;;
	esac
}

connect_wifi() {
	radio="${1:-}"; ssid="${2:-}"; encryption="${3:-sae-mixed}"; key="${4:-}"; bssid="${5:-}"
	ip_mode="${6:-dhcp}"; ipaddr="${7:-}"; netmask="${8:-}"; gateway="${9:-}"
	shift_count=9
	if [ "$#" -ge "$shift_count" ]; then shift "$shift_count"; else set --; fi
	dns1="${1:-}"; dns2="${2:-}"

	[ -n "$radio" ] && uci -q get wireless."$radio" >/dev/null 2>&1 || { echo 'ERROR: valid radio is required.' >&2; exit 2; }
	[ -n "$ssid" ] || { echo 'ERROR: SSID is required.' >&2; exit 3; }
	validate_encryption "$encryption"
	validate_bssid "$bssid" || { echo 'ERROR: invalid BSSID.' >&2; exit 6; }
	if [ "$encryption" != 'none' ] && { [ "${#key}" -lt 8 ] || [ "${#key}" -gt 63 ]; }; then
		echo 'ERROR: Wi-Fi password must contain between 8 and 63 characters.' >&2
		exit 5
	fi

	uci -q set wireless."$radio".disabled='0'
	uci -q delete network.audiowrt_wifi 2>/dev/null || true
	uci -q set network.audiowrt_wifi='interface'
	configure_ip "$ip_mode" "$ipaddr" "$netmask" "$gateway" "$dns1" "$dns2"
	uci -q delete wireless.audiowrt_client 2>/dev/null || true
	uci -q set wireless.audiowrt_client='wifi-iface'
	uci -q set wireless.audiowrt_client.device="$radio"
	uci -q set wireless.audiowrt_client.mode='sta'
	uci -q set wireless.audiowrt_client.network='audiowrt_wifi'
	uci -q set wireless.audiowrt_client.ssid="$ssid"
	uci -q set wireless.audiowrt_client.encryption="$encryption"
	uci -q set wireless.audiowrt_client.disabled='0'
	if [ -n "$bssid" ]; then
		uci -q set wireless.audiowrt_client.bssid="$bssid"
	else
		uci -q delete wireless.audiowrt_client.bssid 2>/dev/null || true
	fi
	if [ "$encryption" = 'none' ]; then
		uci -q delete wireless.audiowrt_client.key 2>/dev/null || true
	else
		uci -q set wireless.audiowrt_client.key="$key"
	fi
	uci -q commit network
	uci -q commit wireless
	wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
	mdns_sync
}

disconnect_wifi() {
	uci -q set wireless.audiowrt_client.disabled='1' 2>/dev/null || true
	uci -q commit wireless
	wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
}

setup_interface_device() {
	ubus call network.interface.audiowrt_setup status 2>/dev/null |
		sed -n 's/^[[:space:]]*"device":[[:space:]]*"\([^"]*\)".*/\1/p' |
		head -n 1
}

wait_setup_interface() {
	tries=0
	while [ "$tries" -lt 15 ]; do
		status="$(ubus call network.interface.audiowrt_setup status 2>/dev/null || true)"
		device="$(printf '%s\n' "$status" |
			sed -n 's/^[[:space:]]*"device":[[:space:]]*"\([^"]*\)".*/\1/p' |
			head -n 1)"
		if [ -n "$device" ] &&
		   printf '%s\n' "$status" | grep -q '"up":[[:space:]]*true' &&
		   ip link show "$device" >/dev/null 2>&1; then
			printf '%s\n' "$device"
			return 0
		fi
		sleep 1
		tries=$((tries + 1))
	done
	return 1
}

setup_dhcp_enable() {
	setup_ip="$1"
	interface="$2"
	# Provisioning is the only DHCP server use case. Use the standalone BusyBox
	# udhcpd binary instead of installing OpenWrt's long-running DHCP daemon.
	[ -x /usr/sbin/udhcpd ] || return 0
	[ -n "$interface" ] || {
		echo 'ERROR: provisioning interface is not available for DHCP.' >&2
		return 1
	}
	cat > /tmp/audiowrt-udhcpd.conf <<-EOF
	start ${setup_ip%.*}.100
	end ${setup_ip%.*}.199
	interface $interface
	max_leases 100
	lease_file /tmp/audiowrt-udhcpd.leases
	pidfile /var/run/audiowrt-udhcpd.pid
	option lease 600
	option router $setup_ip
	option dns $setup_ip
	option subnet 255.255.255.0
	EOF
	: > /tmp/audiowrt-udhcpd.leases
}

setup_dhcp_disable() {
	killall udhcpd 2>/dev/null || true
	rm -f /tmp/audiowrt-udhcpd.conf /tmp/audiowrt-udhcpd.leases /var/run/audiowrt-udhcpd.pid
}

setup_start() {
	radio="${1:-}"; ssid="${2:-AudioWRT-Setup}"; setup_ip="${3:-192.168.77.1}"
	[ -n "$radio" ] && uci -q get wireless."$radio" >/dev/null 2>&1 || { echo 'ERROR: valid radio is required.' >&2; exit 2; }

	uci -q set wireless."$radio".disabled='0'
	uci -q delete network.audiowrt_setup 2>/dev/null || true
	uci -q set network.audiowrt_setup='interface'
	uci -q set network.audiowrt_setup.proto='static'
	uci -q set network.audiowrt_setup.ipaddr="$setup_ip"
	uci -q set network.audiowrt_setup.netmask='255.255.255.0'

	uci -q delete wireless.audiowrt_setup 2>/dev/null || true
	uci -q set wireless.audiowrt_setup='wifi-iface'
	uci -q set wireless.audiowrt_setup.device="$radio"
	uci -q set wireless.audiowrt_setup.mode='ap'
	uci -q set wireless.audiowrt_setup.network='audiowrt_setup'
	uci -q set wireless.audiowrt_setup.ssid="$ssid"
	uci -q set wireless.audiowrt_setup.encryption='none'
	uci -q set wireless.audiowrt_setup.isolate='1'
	uci -q set wireless.audiowrt_setup.disabled='0'

	uci -q commit network
	uci -q commit wireless

	if ! wifi reload >/dev/null 2>&1 && ! wifi >/dev/null 2>&1; then
		echo 'ERROR: failed to reload Wi-Fi for provisioning AP.' >&2
		return 13
	fi

	setup_if="$(wait_setup_interface || true)"
	[ -n "$setup_if" ] || {
		echo 'ERROR: provisioning AP did not become operational.' >&2
		return 14
	}

	if [ -x /usr/sbin/udhcpd ]; then
		setup_dhcp_enable "$setup_ip" "$setup_if" || return 15
		[ -x /etc/init.d/audiowrt-udhcpd ] || {
			echo 'ERROR: AudioWRT DHCP service is missing.' >&2
			return 16
		}
		/etc/init.d/audiowrt-udhcpd restart >/dev/null 2>&1 || {
			echo 'ERROR: failed to start provisioning DHCP.' >&2
			return 17
		}
		sleep 1
		ps w | grep -q '[u]dhcpd .*audiowrt-udhcpd.conf' || {
			echo 'ERROR: provisioning DHCP did not stay running.' >&2
			return 18
		}
	fi

	mdns_sync
}

setup_stop() {
	uci -q set wireless.audiowrt_setup.disabled='1' 2>/dev/null || true
	uci -q commit wireless
	setup_dhcp_disable
	wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
	mdns_sync
}

mdns_sync() {
	# Native AudioWRT renderer owns mDNS/DNS-SD in current images. It derives
	# interface addresses dynamically, so a reload is only needed to refresh
	# identity/friendly-name state after provisioning changes.
	if [ -x /usr/libexec/audiowrt-renderer ] && [ -x /etc/init.d/audiowrt-renderer ]; then
		/etc/init.d/audiowrt-renderer reload >/dev/null 2>&1 || true
		return 0
	fi

	# Backward compatibility for older/non-renderer installations that still
	# provide umdns. Never make Wi-Fi provisioning depend on mDNS availability.
	if [ -x /etc/init.d/umdns ]; then
		uci -q get umdns.@umdns[0] >/dev/null 2>&1 || uci -q add umdns umdns >/dev/null 2>&1 || true
		if uci -q get umdns.@umdns[0] >/dev/null 2>&1; then
			for network in lan audiowrt_wifi audiowrt_setup; do
				uci -q del_list umdns.@umdns[0].network="$network" 2>/dev/null || true
				uci -q add_list umdns.@umdns[0].network="$network" 2>/dev/null || true
			done
			uci -q commit umdns 2>/dev/null || true
			/etc/init.d/umdns enable >/dev/null 2>&1 || true
			/etc/init.d/umdns restart >/dev/null 2>&1 || true
		fi
	fi
	return 0
}

case "${1:-}" in
	radios) radios ;;
	scan) scan ;;
	status) status ;;
	connect) shift; connect_wifi "$@" ;;
	disconnect) disconnect_wifi ;;
	setup-start) shift; setup_start "$@" ;;
	setup-stop) setup_stop ;;
	mdns-sync) mdns_sync ;;
	*) usage; exit 2 ;;
esac
