#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

/usr/libexec/audiowrt-player-registry register \
	lpcm native_lpcm \
	'AudioWRT DLNA LPCM Player' \
	/usr/bin/audiowrt-player-lpcm \
	'audio/L16 audio/l16 audio/L16;rate=44100;channels=2 audio/L16;rate=48000;channels=2' \
	'l16 pcm' >/dev/null 2>&1 || true
exit 0
