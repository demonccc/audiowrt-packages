{
  "luci-app-audiowrt-renderer": {
    "description": "Grant access to AudioWRT renderer configuration, playback registries and status",
    "read": {
      "uci": [ "audiowrt-dlna", "audiowrt-codecs", "audiowrt-players" ],
      "file": { "/usr/libexec/audiowrt-renderer": [ "exec" ] }
    },
    "write": {
      "uci": [ "audiowrt-dlna" ],
      "file": { "/usr/libexec/audiowrt-renderer": [ "exec" ] }
    }
  }
}
