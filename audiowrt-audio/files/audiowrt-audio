#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

STATE_FILE=/tmp/audiowrt/audio.state

name() {
	hostname="$(uci -q get system.@system[0].hostname || true)"
	[ -n "$hostname" ] || hostname='AudioWRT'
	printf '%s\n' "$hostname"
}

state_value() {
	key="$1"
	[ -r "$STATE_FILE" ] || return 0
	sed -n "s/^$key=//p" "$STATE_FILE" | head -n 1
}

status() {
	printf 'device_name=%s\n' "$(name)"
	printf 'output_type=%s\n' "$(state_value output_type || true)"
	printf 'ready=%s\n' "$(state_value ready || true)"
	printf 'device=%s\n' "$(state_value device || true)"
	printf 'card=%s\n' "$(state_value card || true)"
	printf 'pcm=%s\n' "$(state_value pcm || true)"
	printf 'bluetooth_device=%s\n' "$(state_value bluetooth_device || true)"
	printf 'bluetooth_name=%s\n' "$(state_value bluetooth_name || true)"
	printf 'last_error=%s\n' "$(state_value last_error || true)"
}

set_usb() {
	if [ -x /usr/libexec/audiowrt/select-audio-output ]; then
		/usr/libexec/audiowrt/select-audio-output
	else
		mkdir -p /tmp/audiowrt
		cat > "$STATE_FILE" <<EOF
output_type=usb
ready=0
device=
card=
pcm=
bluetooth_device=
bluetooth_name=
last_error=AudioWRT USB audio support is not installed.
EOF
		echo 'ERROR: audiowrt-usb-audio is not installed.' >&2
		exit 3
	fi
}

case "${1:-}" in
	name) name ;;
	status) status ;;
	output)
		case "${2:-}" in
			usb) set_usb ;;
			*) echo 'Usage: audiowrt-audio output usb' >&2; exit 2 ;;
		esac
		;;
	*)
		echo 'Usage: audiowrt-audio {name|status|output usb}' >&2
		exit 2
		;;
esac
