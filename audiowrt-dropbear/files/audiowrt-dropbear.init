#!/bin/sh /etc/rc.common

START=19
STOP=50
USE_PROCD=1
PROG=/usr/sbin/dropbear
KEY=/etc/dropbear/dropbear_ed25519_host_key

start_service() {
	mkdir -p /etc/dropbear
	[ -s "$KEY" ] || /usr/bin/dropbearkey -t ed25519 -f "$KEY" >/dev/null 2>&1

	procd_open_instance
	procd_set_param command "$PROG" -F -E -r "$KEY" -p 22
	procd_set_param respawn
	procd_close_instance
}
