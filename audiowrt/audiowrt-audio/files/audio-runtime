#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
RUNTIME_DIR=/tmp/audiowrt
STATE_FILE="$RUNTIME_DIR/audio.state"
ASOUND_FILE="$RUNTIME_DIR/asound.conf"

state_value() {
	[ -r "$STATE_FILE" ] || return 0
	sed -n "s/^$1=//p" "$STATE_FILE" | head -n 1
}

audio_lock() {
	mkdir -p "$RUNTIME_DIR"
	local tries=0
	until mkdir "$RUNTIME_DIR/audio.lock" 2>/dev/null; do
		[ "$tries" -lt 5 ] || return 1
		sleep 1; tries=$((tries + 1))
	done
	trap 'rmdir "$RUNTIME_DIR/audio.lock"' EXIT
	trap 'exit 1' HUP INT TERM
}

audio_state() {
	local tmp
	mkdir -p "$RUNTIME_DIR"
	tmp=$(mktemp "$RUNTIME_DIR/state.XXXXXX")
	printf 'output_type=%s\nready=%s\ndevice=default\ncard=%s\npcm=%s\nbluetooth_device=%s\nbluetooth_name=%s\nlast_error=%s\n' \
		"$1" "$2" "$3" "$4" "$5" "$6" "$7" > "$tmp"
	if cmp -s "$tmp" "$STATE_FILE"; then rm -f "$tmp"; else mv "$tmp" "$STATE_FILE"; fi
}

audio_asound() {
	local tmp
	mkdir -p "$RUNTIME_DIR"
	tmp=$(mktemp "$RUNTIME_DIR/asound.XXXXXX")
	cat > "$tmp"
	if cmp -s "$tmp" "$ASOUND_FILE"; then rm -f "$tmp"; else mv "$tmp" "$ASOUND_FILE"; fi
}

restart_engines() {
	local signature service
	signature=$({ sed '/^last_error=/d; /^bluetooth_name=/d' "$STATE_FILE"; cat "$ASOUND_FILE" 2>/dev/null || true; } | sha256sum)
	[ "$(cat "$RUNTIME_DIR/audio.engine-signature" 2>/dev/null || true)" != "$signature" ] || return 0
	printf '%s\n' "$signature" > "$RUNTIME_DIR/audio.engine-signature"
	for service in mpd shairport-sync librespot; do
		[ -x "/etc/init.d/$service" ] || continue
		"/etc/init.d/$service" enabled && "/etc/init.d/$service" running || continue
		"/etc/init.d/$service" restart >/dev/null 2>&1 || true
	done
}
