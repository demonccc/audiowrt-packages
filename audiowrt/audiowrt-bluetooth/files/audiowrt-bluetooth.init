#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=59
STOP=20
USE_PROCD=1

start_service() {
	/usr/sbin/audiowrt-bluetooth restore >/dev/null 2>&1 || true

	procd_open_instance
	procd_set_param command /usr/sbin/audiowrt-bluetooth watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
