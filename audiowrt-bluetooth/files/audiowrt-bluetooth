#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

. /usr/libexec/audiowrt/audio-runtime
BLOCKED_FILE="$RUNTIME_DIR/bluetooth.blocked"
BT_CONFIG=audiowrt-bluetooth

upper_mac() {
	printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

valid_mac() {
	printf '%s\n' "$1" | grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'
}

section_for_mac() {
	printf 'dev_%s\n' "$(printf '%s' "$1" | tr -d ':' | tr '[:upper:]' '[:lower:]')"
}

ensure_runtime() {
	mkdir -p "$RUNTIME_DIR"
}

ensure_services() {
	/etc/init.d/dbus start >/dev/null 2>&1 || true
	/etc/init.d/bluetoothd start >/dev/null 2>&1 || true
	/etc/init.d/bluealsa start >/dev/null 2>&1 || true
	/usr/bin/audiowrt-btctl power >/dev/null 2>&1 || true
}

runtime_selected() {
	[ -r "$STATE_FILE" ] || return 0
	sed -n 's/^bluetooth_device=//p' "$STATE_FILE" | head -n 1
}

runtime_ready() {
	[ -r "$STATE_FILE" ] || { printf '0\n'; return 0; }
	ready="$(sed -n 's/^ready=//p' "$STATE_FILE" | head -n 1)"
	case "$ready" in
		1) printf '1\n' ;;
		*) printf '0\n' ;;
	esac
}

preferred() {
	uci -q get "$BT_CONFIG.main.preferred_device" || true
}

is_saved() {
	mac="$(upper_mac "$1")"
	section="$(section_for_mac "$mac")"
	[ "$(uci -q get "$BT_CONFIG.$section.mac" 2>/dev/null || true)" = "$mac" ]
}

is_blocked() {
	mac="$(upper_mac "$1")"
	[ -r "$BLOCKED_FILE" ] && [ "$(cat "$BLOCKED_FILE" 2>/dev/null || true)" = "$mac" ]
}

unblock() {
	mac="$(upper_mac "$1")"
	if is_blocked "$mac"; then
		rm -f "$BLOCKED_FILE"
	fi
}

write_runtime_state() {
	audio_state bluetooth "$3" '' '' "$1" "$2" "${4:-}"
}

write_asound_config() {
	mac="$(upper_mac "$1")"
	ensure_runtime

	audio_asound <<EOF
defaults.bluealsa.service "org.bluealsa"
defaults.bluealsa.device "$mac"
defaults.bluealsa.profile "a2dp"

pcm.!default {
	type plug
	slave.pcm "bluealsa"
}
EOF
}

clear_runtime_state() {
	write_runtime_state "" "" 0 "${1:-Bluetooth output is not connected.}"
	rm -f "$ASOUND_FILE"
}

device_line() {
	mac="$(upper_mac "$1")"
	/usr/bin/audiowrt-btctl devices 2>/dev/null | awk -F'|' -v wanted="$mac" '
		toupper($1) == wanted { print; exit }
	'
}

device_connected() {
	line="$(device_line "$1")"
	[ -n "$line" ] || return 1
	[ "$(printf '%s\n' "$line" | awk -F'|' '{print $4}')" = "1" ]
}

device_paired() {
	line="$(device_line "$1")"
	[ -n "$line" ] || return 1
	[ "$(printf '%s\n' "$line" | awk -F'|' '{print $3}')" = "1" ]
}

device_name() {
	line="$(device_line "$1")"
	if [ -n "$line" ]; then
		printf '%s\n' "$line" | awk -F'|' '{print $2}'
	else
		section="$(section_for_mac "$1")"
		uci -q get "$BT_CONFIG.$section.name" 2>/dev/null || printf '%s\n' "$1"
	fi
}

configure_device() (
	audio_lock
	mac="$(upper_mac "$1")"
	name="$(device_name "$mac")"
	write_asound_config "$mac"
	write_runtime_state "$mac" "$name" 1 ""
	restart_engines
)

prime_saved_output() {
	mac="$(upper_mac "$(preferred)")"
	[ -n "$mac" ] || return 0
	valid_mac "$mac" || return 0
	is_saved "$mac" || return 0

	section="$(section_for_mac "$mac")"
	name="$(uci -q get "$BT_CONFIG.$section.name" 2>/dev/null || printf '%s\n' "$mac")"

	# The ALSA route is configuration derived from the explicit Save action.
	# Recreate it in tmpfs on every boot even while the speaker is offline, so
	# the configured route is available when the speaker reconnects.
	write_asound_config "$mac"
	write_runtime_state "$mac" "$name" 0 "Waiting for saved Bluetooth output."
}

format_devices() {
	selected_mac="$(upper_mac "$(runtime_selected)")"
	preferred_mac="$(upper_mac "$(preferred)")"
	seen=" "

	while IFS='|' read -r mac name paired connected; do
		[ -n "$mac" ] || continue
		valid_mac "$mac" || continue
		mac="$(upper_mac "$mac")"
		is_selected=0
		is_saved_flag=0
		is_preferred=0
		[ "$mac" = "$selected_mac" ] && is_selected=1
		is_saved "$mac" && is_saved_flag=1
		[ "$mac" = "$preferred_mac" ] && is_preferred=1
		printf '%s|%s|%s|%s|%s|%s|%s|1\n' \
			"$mac" "$name" "${paired:-0}" "${connected:-0}" \
			"$is_selected" "$is_saved_flag" "$is_preferred"
		seen="$seen$mac "
	done

	for section in $(uci -q show "$BT_CONFIG" 2>/dev/null | sed -n "s/^$BT_CONFIG\.\([^.=]*\)=device$/\1/p"); do
		mac="$(upper_mac "$(uci -q get "$BT_CONFIG.$section.mac" 2>/dev/null || true)")"
		[ -n "$mac" ] || continue
		case "$seen" in *" $mac "*) continue ;; esac
		name="$(uci -q get "$BT_CONFIG.$section.name" 2>/dev/null || printf '%s' "$mac")"
		is_selected=0
		is_preferred=0
		[ "$mac" = "$selected_mac" ] && is_selected=1
		[ "$mac" = "$preferred_mac" ] && is_preferred=1
		printf '%s|%s|0|0|%s|1|%s|0\n' \
			"$mac" "$name" "$is_selected" "$is_preferred"
	done
}

devices() {
	/usr/bin/audiowrt-btctl devices | format_devices
}

scan() {
	seconds="${1:-8}"
	case "$seconds" in ''|*[!0-9]*) seconds=8 ;; esac
	[ "$seconds" -ge 2 ] || seconds=2
	[ "$seconds" -le 30 ] || seconds=30
	ensure_services
	/usr/bin/audiowrt-btctl scan "$seconds" | format_devices
}

pair_device() {
	mac="$(upper_mac "${1:-}")"
	valid_mac "$mac" || { echo 'ERROR: invalid Bluetooth MAC address.' >&2; exit 2; }
	ensure_services
	unblock "$mac"
	/usr/bin/audiowrt-btctl pair "$mac"
}

connect_device() {
	mac="$(upper_mac "${1:-}")"
	valid_mac "$mac" || { echo 'ERROR: invalid Bluetooth MAC address.' >&2; exit 2; }
	ensure_services
	unblock "$mac"
	/usr/bin/audiowrt-btctl connect "$mac"
}

use_device() {
	mac="$(upper_mac "${1:-}")"
	valid_mac "$mac" || { echo 'ERROR: invalid Bluetooth MAC address.' >&2; exit 2; }
	ensure_services
	unblock "$mac"

	if ! device_connected "$mac"; then
		/usr/bin/audiowrt-btctl connect "$mac" >/dev/null || {
			echo "ERROR: could not connect to Bluetooth device $mac." >&2
			exit 3
		}
	fi

	old="$(upper_mac "$(runtime_selected)")"
	if [ -n "$old" ] && [ "$old" != "$mac" ]; then
		/usr/bin/audiowrt-btctl disconnect "$old" >/dev/null 2>&1 || true
	fi

	configure_device "$mac"
}

disconnect_device() {
	mac="$(upper_mac "${1:-$(runtime_selected)}")"
	[ -n "$mac" ] || exit 0
	valid_mac "$mac" || { echo 'ERROR: invalid Bluetooth MAC address.' >&2; exit 2; }

	/usr/bin/audiowrt-btctl disconnect "$mac" >/dev/null 2>&1 || true
	if [ "$mac" = "$(upper_mac "$(runtime_selected)")" ]; then
		ensure_runtime
		printf '%s\n' "$mac" > "$BLOCKED_FILE"
		clear_runtime_state "Selected Bluetooth output is disconnected."
		restart_engines
	fi
}

save_device() (
	mac="$(upper_mac "${1:-}")"
	valid_mac "$mac" || { echo 'ERROR: invalid Bluetooth MAC address.' >&2; exit 2; }
	ensure_services
	device_paired "$mac" || {
		echo "ERROR: Bluetooth device $mac must be paired before it can be saved." >&2
		exit 3
	}

	storage="$(/usr/bin/audiowrt-btctl storage-export "$mac")" || exit $?
	adapter="${storage%%|*}"
	encoded="${storage#*|}"
	[ -n "$adapter" ] && [ -n "$encoded" ] || {
		echo "ERROR: could not capture Bluetooth pairing state for $mac." >&2
		exit 4
	}

	section="$(section_for_mac "$mac")"
	name="$(device_name "$mac")"
	. /usr/libexec/audiowrt/config-save
	save_begin "$BT_CONFIG"
	uci() { save_uci "$@"; }
	uci -q set "$BT_CONFIG.$section=device"
	uci -q set "$BT_CONFIG.$section.mac=$mac"
	uci -q set "$BT_CONFIG.$section.name=$name"
	uci -q set "$BT_CONFIG.$section.adapter=$adapter"
	uci -q set "$BT_CONFIG.$section.bluez_info_b64=$encoded"
	uci -q set "$BT_CONFIG.main.preferred_device=$mac"
	save_finish
)

restore_saved() {
	mkdir -p /tmp/lib/bluetooth
	for section in $(uci -q show "$BT_CONFIG" 2>/dev/null | sed -n "s/^$BT_CONFIG\.\([^.=]*\)=device$/\1/p"); do
		mac="$(uci -q get "$BT_CONFIG.$section.mac" 2>/dev/null || true)"
		adapter="$(uci -q get "$BT_CONFIG.$section.adapter" 2>/dev/null || true)"
		encoded="$(uci -q get "$BT_CONFIG.$section.bluez_info_b64" 2>/dev/null || true)"
		[ -n "$mac" ] && [ -n "$adapter" ] && [ -n "$encoded" ] || continue
		/usr/bin/audiowrt-btctl storage-import "$adapter" "$(upper_mac "$mac")" "$encoded" >/dev/null 2>&1 || true
	done

	prime_saved_output
}

watch_saved() {
	while :; do
		sleep 5
		/usr/bin/audiowrt-btctl power >/dev/null 2>&1 || continue
		mac="$(upper_mac "$(preferred)")"
		[ -n "$mac" ] || continue
		is_blocked "$mac" && continue

		current="$(upper_mac "$(runtime_selected)")"
		[ -z "$current" ] || [ "$current" = "$mac" ] || continue

		if device_connected "$mac"; then
			if [ "$current" != "$mac" ] || [ "$(runtime_ready)" != "1" ]; then
				configure_device "$mac"
			fi
			continue
		fi

		/usr/bin/audiowrt-btctl connect "$mac" >/dev/null 2>&1 || continue
		device_connected "$mac" && configure_device "$mac"
	done
}

status() {
	selected_mac="$(upper_mac "$(runtime_selected)")"
	ready=0
	[ -n "$selected_mac" ] && device_connected "$selected_mac" && ready=1
	printf 'selected=%s\n' "$selected_mac"
	printf 'preferred=%s\n' "$(preferred)"
	printf 'ready=%s\n' "$ready"
}

case "${1:-}" in
	status) status ;;
	adapters) /usr/bin/audiowrt-btctl adapters ;;
	devices) devices ;;
	scan) scan "${2:-8}" ;;
	pair) pair_device "${2:-}" ;;
	connect) connect_device "${2:-}" ;;
	use|select) use_device "${2:-}" ;;
	disconnect) disconnect_device "${2:-}" ;;
	save) save_device "${2:-}" ;;
	restore) restore_saved ;;
	watch) watch_saved ;;
	usb) /usr/sbin/audiowrt-audio output usb ;;
	*)
		echo 'Usage: audiowrt-bluetooth {status|adapters|devices|scan [seconds]|pair <MAC>|connect <MAC>|use <MAC>|disconnect [MAC]|save <MAC>|restore|watch|usb}' >&2
		exit 2
		;;
esac
