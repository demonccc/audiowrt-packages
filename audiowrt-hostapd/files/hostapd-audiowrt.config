# AudioWRT temporary provisioning AP.
# The setup SSID is intentionally open; station-side WPA2/WPA3 is provided by
# audiowrt-wpa-supplicant and must not be duplicated here.
CONFIG_DRIVER_NL80211=y

# Keep 802.11n for the 2.4 GHz setup radio used by constrained devices such as
# the TL-WDR4300, but omit VHT/HE/EHT feature sets from this tiny AP build.
CONFIG_IEEE80211N=y

# OpenWrt netifd/wifi-scripts integration.
CONFIG_UBUS=y

# /etc/init.d/wpad starts hostapd with -s and a global control socket.
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON

# Strip features not used by the unencrypted provisioning AP.
CONFIG_NO_WPA=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_RADIUS=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y
CONFIG_NO_STDOUT_DEBUG=y

# Small Linux event/random backends.
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CONFIG_ELOOP_EPOLL=y

# No EAP/TLS stack is required for an open AP.
CONFIG_TLS=none
