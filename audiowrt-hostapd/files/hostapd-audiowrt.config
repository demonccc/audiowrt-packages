# AudioWRT temporary provisioning AP.
# The setup SSID is intentionally open. Keep only the hostapd capabilities
# required by OpenWrt netifd to create that AP.

CONFIG_DRIVER_NL80211=y

# The constrained setup AP prefers 2.4 GHz and keeps only 802.11n from the
# optional HT/VHT/HE/EHT feature families.
CONFIG_IEEE80211N=y

# OpenWrt netifd/wifi-scripts integration.
CONFIG_UBUS=y

# /etc/init.d/wpad starts hostapd with -s and a global control socket.
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON

# Strip optional services unused by provisioning.
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_RADIUS=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y
CONFIG_NO_STDOUT_DEBUG=y

# Small Linux event/random backends.
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CONFIG_ELOOP_EPOLL=y

# No EAP method is enabled. Use the crypto-none backend instead of carrying
# the internal TLS implementation used by OpenWrt hostapd-mini.
CONFIG_TLS=none
