{
	"luci-app-audiowrt": {
		"description": "Grant access to the AudioWRT web interface",
		"read": {
			"uci": [ "audiowrt" ],
			"file": {
				"/usr/sbin/audiowrtctl": [ "exec" ],
				"/usr/sbin/audiowrt-storage": [ "exec" ],
				"/usr/sbin/audiowrt-extensions": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "audiowrt" ],
			"file": {
				"/usr/sbin/audiowrtctl": [ "exec" ],
				"/usr/sbin/audiowrt-storage": [ "exec" ],
				"/usr/sbin/audiowrt-extensions": [ "exec" ]
			}
		}
	}
}
