#!/bin/sh /etc/rc.common

START=81
USE_PROCD=1
PROG=/usr/sbin/minidlnad
CONFIG_FILE=/var/etc/minidlna.conf

start_service() {
	local enabled interface friendly_name db_dir media_dir

	config_load minidlna
	config_get_bool enabled config enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get interface config interface
	config_get friendly_name config friendly_name 'AudioWRT DLNA'
	config_get db_dir config db_dir '/var/run/minidlna'
	config_get media_dir config media_dir '/mnt'

	mkdir -p /var/etc "$db_dir"
	{
		echo 'port=8200'
		[ -n "$interface" ] && echo "network_interface=$interface"
		echo "friendly_name=$friendly_name"
		echo "db_dir=$db_dir"
		echo 'log_level=error'
		echo 'inotify=yes'
		echo 'enable_tivo=no'
		echo 'wide_links=no'
		echo 'strict_dlna=no'
		echo 'root_container=Music'
		echo "media_dir=A,$media_dir"
	} > "$CONFIG_FILE"

	procd_open_instance
	procd_set_param command "$PROG" -S -f "$CONFIG_FILE"
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger minidlna
}
