#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu
. /usr/libexec/audiowrt/wifi-runtime

RUNTIME_DIR=/tmp/audiowrt
ERROR_FILE="$RUNTIME_DIR/provisioning.error"
DONE_FILE="$RUNTIME_DIR/provisioning.done"

clear_error() {
	mkdir -p "$RUNTIME_DIR"
	rm -f "$ERROR_FILE"
}

set_error() {
	mkdir -p "$RUNTIME_DIR"
	printf '%s\n' "$1" > "$ERROR_FILE"
}

request_dir="${1:-}"
[ -n "$request_dir" ] && [ -d "$request_dir" ] || exit 2
trap 'rmdir /tmp/audiowrt/provision.lock 2>/dev/null || true' EXIT
trap 'exit 1' INT TERM
radio="$(cat "$request_dir/radio" 2>/dev/null || true)"
ssid="$(cat "$request_dir/ssid" 2>/dev/null || true)"
bssid="$(cat "$request_dir/bssid" 2>/dev/null || true)"
encryption="$(cat "$request_dir/encryption" 2>/dev/null || echo sae-mixed)"
key="$(cat "$request_dir/wifi_key" 2>/dev/null || true)"

[ -n "$radio" ] || exit 2
[ -n "$ssid" ] || exit 3
audiowrt_setup_active || exit 4
timeout="$AUDIOWRT_SETUP_TIMEOUT"
setup_radio="$(cat "$AUDIOWRT_SETUP_DIR/radio")"
setup_ssid="$(cat "$AUDIOWRT_SETUP_DIR/ssid")"
active_setup_radio="$setup_radio"

clear_error
rm -f "$DONE_FILE"

# Provisioning must not depend on AP+STA support on the same PHY. If the
# target STA uses the setup radio, move the setup AP to another radio when one
# exists; otherwise close the setup AP before switching the only radio to STA.
if [ "$radio" = "$setup_radio" ]; then
	alternate_radio="$(/usr/sbin/audiowrt-wifi-client radios 2>/dev/null | cut -d '|' -f 1 | grep -Fvx "$radio" | head -n 1 || true)"
	if [ -n "$alternate_radio" ]; then
		if /usr/sbin/audiowrt-wifi-client setup-start "$alternate_radio" "$setup_ssid"; then
			active_setup_radio="$alternate_radio"
		else
			active_setup_radio=''
		fi
		logger -t audiowrt "Moved setup AP from $setup_radio to $alternate_radio before STA handoff"
	else
		/usr/sbin/audiowrt-wifi-client setup-stop >/dev/null 2>&1 || true
		active_setup_radio=''
		logger -t audiowrt "Single-radio provisioning: setup AP stopped before STA handoff"
	fi
fi

if ! /usr/sbin/audiowrt-wifi-client connect "$radio" "$ssid" "$encryption" "$key" "$bssid"; then
	/usr/sbin/audiowrt-wifi-client rollback-client >/dev/null 2>&1 || true
	[ -n "$active_setup_radio" ] || /usr/sbin/audiowrt-wifi-client setup-start "$setup_radio" "$setup_ssid" >/dev/null 2>&1 || true
	set_error 'Could not apply the selected Wi-Fi configuration.'
	exit 5
fi

elapsed=0
connected=0
while [ "$elapsed" -lt "$timeout" ]; do
	if audiowrt_client_up; then
		connected=1
		break
	fi
	sleep 2
	elapsed=$((elapsed + 2))
done

if [ "$connected" -eq 1 ]; then
	: > /tmp/audiowrt/wifi.verified
	clear_error
	# With one PHY, restore the setup AP so the user can explicitly Save.
	# The tested candidate remains private in RAM; no connection auto-saves.
	if [ -z "$active_setup_radio" ]; then
		/usr/sbin/audiowrt-wifi-client rollback-client
		/usr/sbin/audiowrt-wifi-client setup-start "$setup_radio" "$setup_ssid"
	elif ! audiowrt_setup_active; then
		/usr/sbin/audiowrt-wifi-client setup-start "$active_setup_radio" "$setup_ssid"
	fi
	logger -t audiowrt 'Wi-Fi test succeeded; waiting for explicit Save'
	exit 0
fi

/usr/sbin/audiowrt-wifi-client rollback-client >/dev/null 2>&1 || true
/usr/sbin/audiowrt-wifi-client setup-start "$setup_radio" "$setup_ssid" >/dev/null 2>&1 || true
set_error 'Could not connect to the selected Wi-Fi network. The setup network has been restored; check the network and password.'
exit 7
