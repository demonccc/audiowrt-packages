#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
. /usr/libexec/audiowrt/wifi-runtime

WEB_DIR="$AUDIOWRT_SETUP_DIR/www"
PID_FILE="$AUDIOWRT_SETUP_DIR/uhttpd.pid"

stop_web() {
	pid="$(cat "$PID_FILE" 2>/dev/null || true)"
	case "$pid" in ''|*[!0-9]*) ;; *)
		kill "$pid" 2>/dev/null || true
		tries=0
		while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 5 ]; do
			sleep 1
			tries=$((tries + 1))
		done
		;;
	esac
	rm -f "$PID_FILE"
}

start_web() {
	stop_web
	mkdir -p "$WEB_DIR/cgi-bin"
	cp /www/audiowrt.html "$WEB_DIR/index.html"
	for cgi in audiowrt-status audiowrt-scan audiowrt-radios audiowrt-provision; do
		cp "/www/cgi-bin/$cgi" "$WEB_DIR/cgi-bin/$cgi"
	done

	uhttpd -f \
		-h "$WEB_DIR" \
		-x /cgi-bin \
		-p "$AUDIOWRT_SETUP_IP:80" </dev/null >"$AUDIOWRT_SETUP_DIR/uhttpd.log" 2>&1 &
	printf '%s\n' "$!" > "$PID_FILE"
	sleep 1
	kill -0 "$(cat "$PID_FILE")" 2>/dev/null || {
		cat "$AUDIOWRT_SETUP_DIR/uhttpd.log" >&2
		return 1
	}
}

case "${1:-}" in
	start) start_web ;;
	stop) stop_web; rm -rf "$WEB_DIR" ;;
	*) exit 2 ;;
esac
