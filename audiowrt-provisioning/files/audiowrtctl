#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

setup_ip() { uci -q get audiowrt.main.setup_ip || echo '192.168.77.1'; }
setup_ssid() { /usr/libexec/audiowrt/setup-ssid 2>/dev/null || echo 'AudioWRT-Setup'; }
first_radio() { /usr/sbin/audiowrt-wifi-client radios 2>/dev/null | sed -n '1s/|.*//p'; }
error_file=/tmp/audiowrt/provisioning.error

clear_error() { mkdir -p /tmp/audiowrt; rm -f "$error_file"; }
set_provisioning() {
	value="$1"
	current="$(uci -q get audiowrt.main.provisioning 2>/dev/null || true)"
	[ -n "$current" ] && [ "$current" = "$value" ] && return 0
	uci -q set audiowrt.main.provisioning="$value"
	uci -q commit audiowrt
}

provisioning_start() {
	radio="$(first_radio)"
	[ -n "$radio" ] || { echo 'ERROR: no Wi-Fi radio is available.' >&2; exit 3; }
	/usr/sbin/audiowrt-wifi-client disconnect >/dev/null 2>&1 || true
	/usr/sbin/audiowrt-wifi-client setup-start "$radio" "$(setup_ssid)" "$(setup_ip)"
	set_provisioning 1
	clear_error
	logger -t audiowrt "Provisioning mode enabled"
}

provisioning_stop() {
	/usr/sbin/audiowrt-wifi-client setup-stop >/dev/null 2>&1 || true
	set_provisioning 0
}

status() {
	printf 'device_name=%s\n' "$(uci -q get system.@system[0].hostname || echo AudioWRT)"
	printf 'provisioning=%s\n' "$(uci -q get audiowrt.main.provisioning || echo 1)"
	printf 'wifi_ssid=%s\n' "$(uci -q get wireless.audiowrt_client.ssid || true)"
	printf 'last_error=%s\n' "$(cat "$error_file" 2>/dev/null || true)"
}

case "${1:-}" in
	status) status ;;
	provisioning)
		case "${2:-}" in
			start) provisioning_start ;;
			stop) provisioning_stop ;;
			*) echo 'Usage: audiowrtctl provisioning {start|stop}' >&2; exit 2 ;;
		esac
		;;
	*) echo 'Usage: audiowrtctl {status|provisioning start|provisioning stop}' >&2; exit 2 ;;
esac
