#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

. /usr/libexec/audiowrt/wifi-runtime

error_file=/tmp/audiowrt/provisioning.error
done_file=/tmp/audiowrt/provisioning.done

start_setup() {
	reason="$1"
	radio="$(audiowrt_first_radio)"
	[ -n "$radio" ] || { echo 'ERROR: no Wi-Fi radio is available.' >&2; return 3; }
	/usr/sbin/audiowrt-wifi-client setup-start "$radio" "$(/usr/libexec/audiowrt/setup-ssid)"
	mkdir -p /tmp/audiowrt
	rm -f "$error_file"
	rm -f "$done_file"
	logger -t audiowrt "Provisioning mode enabled ($reason)"
}

provisioning_start() {
	# Manual recovery must not rewrite or destroy the saved Wi-Fi profile. Bring
	# the current client down only for this boot, then expose the setup AP.
	ubus call network.interface.audiowrt_wifi down >/dev/null 2>&1 || true
	start_setup 'manual request'
}

provisioning_auto() {
	# Boot order is intentional: configured Wi-Fi first, then LAN.
	# Provisioning starts only when neither path provides link + an IP.
	if uci -q get wireless.audiowrt_client >/dev/null 2>&1; then
		elapsed=0
		while [ "$elapsed" -lt "$AUDIOWRT_SETUP_TIMEOUT" ]; do
			if audiowrt_client_up; then
				/usr/libexec/audiowrt/time-sync || true
				return 0
			fi
			sleep 2
			elapsed=$((elapsed + 2))
		done
	fi

	elapsed=0
	while [ "$elapsed" -lt "$AUDIOWRT_SETUP_TIMEOUT" ]; do
		if audiowrt_interface_up lan; then
			/usr/libexec/audiowrt/time-sync || true
			return 0
		fi
		sleep 2
		elapsed=$((elapsed + 2))
	done

	start_setup 'no usable Wi-Fi client or LAN connection'
}

provisioning_stop() {
	/usr/sbin/audiowrt-wifi-client setup-stop >/dev/null 2>&1 || true
}

status() {
	provisioning=0
	if audiowrt_setup_active && [ ! -f "$done_file" ]; then
		provisioning=1
	fi
	printf 'device_name=%s\n' "$(uci -q get system.@system[0].hostname || echo AudioWRT)"
	printf 'provisioning=%s\n' "$provisioning"
	printf 'wifi_ssid=%s\n' "$(uci -q get wireless.audiowrt_client.ssid || true)"
	printf 'lan_dhcp=%s\n' "$(audiowrt_connected && echo 1 || echo 0)"
	printf 'last_error=%s\n' "$(cat "$error_file" 2>/dev/null || true)"
}

case "${1:-}" in
	status) status ;;
	provisioning)
		case "${2:-}" in
			auto) provisioning_auto ;;
			start) provisioning_start ;;
			stop) provisioning_stop ;;
			*) echo 'Usage: audiowrtctl provisioning {auto|start|stop}' >&2; exit 2 ;;
		esac
		;;
	*) echo 'Usage: audiowrtctl {status|provisioning auto|provisioning start|provisioning stop}' >&2; exit 2 ;;
esac
