#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
. /usr/libexec/audiowrt/wifi-runtime
mkdir -p /tmp/audiowrt
trap '/usr/libexec/audiowrt/setup-ap stop' EXIT
trap 'exit 0' INT TERM HUP
/usr/sbin/audiowrtctl provisioning auto || logger -t audiowrt "Initial provisioning check failed"
while :; do
	sleep 3
	if [ -f /tmp/audiowrt/provisioning.saved ]; then
		rm -f /tmp/audiowrt/provisioning.saved
		/usr/libexec/audiowrt/setup-ap stop
		if ! /usr/sbin/audiowrt-wifi-client apply-candidate; then
			/usr/sbin/audiowrtctl provisioning start || true
			printf '%s\n' 'Could not apply saved Wi-Fi; setup AP restored.' > /tmp/audiowrt/provisioning.error
			continue
		fi
		elapsed=0
		while [ "$elapsed" -lt "$AUDIOWRT_SETUP_TIMEOUT" ]; do
			if audiowrt_client_up; then
				/usr/libexec/audiowrt/time-sync || true
				: > /tmp/audiowrt/provisioning.done
				rm -rf /tmp/audiowrt/client
				break
			fi
			sleep 2
			elapsed=$((elapsed + 2))
		done
		if [ ! -f /tmp/audiowrt/provisioning.done ]; then
			/usr/sbin/audiowrtctl provisioning start || true
			printf '%s\n' 'Saved Wi-Fi could not reconnect; setup AP restored.' > /tmp/audiowrt/provisioning.error
		fi
	elif audiowrt_setup_active && [ ! -d /tmp/audiowrt/provision-request ] &&
	     [ ! -d /tmp/audiowrt/provision.lock ] && audiowrt_client_up; then
		/usr/libexec/audiowrt/setup-ap stop
		/usr/libexec/audiowrt/time-sync || true
	fi
done
