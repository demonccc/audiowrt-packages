#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

# This script owns persistent first-install/migration changes only.
# The provisioning AP itself is runtime-only and is decided at every boot by
# /etc/init.d/audiowrt-provisioning.

# Remove setup sections written persistently by older AudioWRT releases.
uci -q delete network.audiowrt_setup 2>/dev/null || true
uci -q delete wireless.audiowrt_setup 2>/dev/null || true

# Keep the board-specific Ethernet topology, but make normal Ethernet a DHCP
# client rather than a router-side static LAN.
if uci -q get network.lan >/dev/null 2>&1; then
	uci -q set network.lan.proto='dhcp'
	uci -q delete network.lan.ipaddr 2>/dev/null || true
	uci -q delete network.lan.netmask 2>/dev/null || true
	uci -q delete network.lan.ip6assign 2>/dev/null || true
	uci -q delete network.lan.gateway 2>/dev/null || true
	uci -q delete network.lan.dns 2>/dev/null || true
fi

# Some full OpenWrt images carry /etc/config/dhcp, while minimal AudioWRT
# images deliberately do not. Never let first boot fail because that optional
# UCI package is absent.
if [ -f /etc/config/dhcp ] && uci -q get dhcp.lan >/dev/null 2>&1; then
	uci -q set dhcp.lan.ignore='1'
	uci -q commit dhcp || true
fi

# Preserve OpenWrt's wifi-device hardware definitions. Disable stock APs, but
# never disable an already-provisioned AudioWRT client during an upgrade.
for section in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface.*/\1/p"); do
	[ "$section" = 'audiowrt_client' ] && continue
	uci -q set wireless."$section".disabled='1'
done

# Keep all discovered radios available. A runtime setup AP may need any band.
for radio_device in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device.*/\1/p"); do
	uci -q set wireless."$radio_device".disabled='0'
done

uci -q commit network
uci -q commit wireless

# Migrate away from the old duplicated provisioning booleans. Provisioning is
# now inferred from real connectivity and the runtime setup interface.
audiowrt_changed=0
for option in provisioning provisioning_initialized; do
	if uci -q get audiowrt.main."$option" >/dev/null 2>&1; then
		uci -q delete audiowrt.main."$option"
		audiowrt_changed=1
	fi
done
[ "$audiowrt_changed" -eq 0 ] || uci -q commit audiowrt

# Keep one permanent root dispatcher. It serves the wizard only when the HTTP
# request arrived on 192.168.77.1; every normal LAN address goes to LuCI.
if uci -q get uhttpd.main >/dev/null 2>&1; then
	uci -q delete uhttpd.main.index_page 2>/dev/null || true
	uci -q add_list uhttpd.main.index_page='cgi-bin/audiowrt-root'
	uci -q commit uhttpd
	/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
fi

exit 0
