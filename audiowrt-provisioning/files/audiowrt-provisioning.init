#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99

start() {
	# Boot-time decision only. The provisioning check must not migrate, commit,
	# or delete persistent configuration. Runtime setup state lives in tmpfs.
	if /usr/sbin/audiowrtctl provisioning auto; then
		logger -t audiowrt "Provisioning boot check completed"
	else
		logger -t audiowrt "Provisioning boot check failed"
	fi
}
