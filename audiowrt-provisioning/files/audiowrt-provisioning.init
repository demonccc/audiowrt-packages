#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99

start() {
    [ "$(uci -q get audiowrt.main.provisioning_initialized || echo 0)" = "1" ] && return 0

    logger -t audiowrt "Running first-boot provisioning fallback"
    if /etc/uci-defaults/10-audiowrt-provisioning; then
        logger -t audiowrt "First-boot provisioning completed"
    else
        logger -t audiowrt "First-boot provisioning failed"
    fi
}
