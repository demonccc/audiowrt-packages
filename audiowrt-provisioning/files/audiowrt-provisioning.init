#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=99
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/audiowrt/provision-supervisor
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
stop_service() {
	/usr/libexec/audiowrt/setup-ap stop
}
