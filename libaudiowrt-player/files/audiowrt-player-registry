#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

CONFIG=audiowrt

reload_renderer() {
	local pids
	pids="$(pidof audiowrt-renderer 2>/dev/null || true)"
	[ -z "$pids" ] || kill -HUP $pids 2>/dev/null || true
}

section_type() {
	uci -q get "$CONFIG.$1" 2>/dev/null || true
}

ensure_section() {
	local id="$1" type="$2" current
	current="$(section_type "$id")"
	if [ -z "$current" ]; then
		uci set "$CONFIG.$id=$type"
		changed=1
	elif [ "$current" != "$type" ]; then
		echo "audiowrt-player-registry: $id already exists as $current, expected $type" >&2
		return 1
	fi
}

list_has() {
	local key="$1" needle="$2" value values
	values="$(uci -q get "$key" 2>/dev/null || true)"
	for value in $values; do
		[ "$value" = "$needle" ] && return 0
	done
	return 1
}

first_available_player() {
	local codec="$1" id executable
	for id in $(uci -q show "$CONFIG" 2>/dev/null | sed -n "s/^$CONFIG\.\([^.=]*\)=player$/\1/p"); do
		list_has "$CONFIG.$id.codec" "$codec" || continue
		executable="$(uci -q get "$CONFIG.$id.executable" 2>/dev/null || true)"
		[ -n "$executable" ] && [ -x "$executable" ] || continue
		printf '%s\n' "$id"
		return 0
	done
	return 1
}

register_player() {
	local codec="$1" player="$2" name="$3" executable="$4" mimes="$5" extensions="$6"
	local item
	changed=0

	ensure_section "$codec" codec
	for item in $mimes; do
		if ! list_has "$CONFIG.$codec.mime" "$item"; then uci add_list "$CONFIG.$codec.mime=$item"; changed=1; fi
	done
	for item in $extensions; do
		if ! list_has "$CONFIG.$codec.extension" "$item"; then uci add_list "$CONFIG.$codec.extension=$item"; changed=1; fi
	done

	ensure_section "$player" player
	if [ -z "$(uci -q get "$CONFIG.$player.name" 2>/dev/null || true)" ]; then
		uci set "$CONFIG.$player.name=$name"
		changed=1
	fi
	if [ -z "$(uci -q get "$CONFIG.$player.executable" 2>/dev/null || true)" ]; then
		uci set "$CONFIG.$player.executable=$executable"
		changed=1
	fi
	if ! list_has "$CONFIG.$player.codec" "$codec"; then
		uci add_list "$CONFIG.$player.codec=$codec"
		changed=1
	fi

	if [ -z "$(uci -q get "$CONFIG.$codec.default_player" 2>/dev/null || true)" ]; then
		uci set "$CONFIG.$codec.default_player=$player"
		changed=1
	fi

	if [ "$changed" -eq 1 ]; then
		uci commit "$CONFIG"
		reload_renderer
	fi
}

unregister_player() {
	local player="$1" codec default replacement codecs
	[ -n "$(section_type "$player")" ] || return 0
	codecs="$(uci -q get "$CONFIG.$player.codec" 2>/dev/null || true)"
	uci -q delete "$CONFIG.$player" || true

	for codec in $codecs; do
		default="$(uci -q get "$CONFIG.$codec.default_player" 2>/dev/null || true)"
		[ "$default" = "$player" ] || continue
		uci -q delete "$CONFIG.$codec.default_player" || true
		replacement="$(first_available_player "$codec" 2>/dev/null || true)"
		[ -z "$replacement" ] || uci set "$CONFIG.$codec.default_player=$replacement"
	done

	uci commit "$CONFIG"
	reload_renderer
}

case "${1:-}" in
	register)
		[ "$#" -eq 7 ] || {
			echo "usage: $0 register <codec> <player-id> <name> <executable> <mime-list> <extension-list>" >&2
			exit 2
		}
		register_player "$2" "$3" "$4" "$5" "$6" "$7"
		;;
	unregister)
		[ "$#" -eq 2 ] || { echo "usage: $0 unregister <player-id>" >&2; exit 2; }
		unregister_player "$2"
		;;
	reload)
		reload_renderer
		;;
	*)
		echo "usage: $0 {register|unregister|reload} ..." >&2
		exit 2
		;;
esac
