#!/bin/sh

CONFIG=audiowrt-dlna
PLAYER_DIR=/usr/share/audiowrt/dlna/players
RUNTIME_DIR=/var/run/audiowrt-dlna

load_main() {
	config_load "$CONFIG"
	config_get PLAYER_DIR main player_dir "$PLAYER_DIR"
	config_get RUNTIME_DIR main runtime_dir "$RUNTIME_DIR"
	mkdir -p "$RUNTIME_DIR"
}

read_descriptor() {
	local file="$1"
	PLAYER_ID=
	PLAYER_NAME=
	PLAYER_COMMAND=
	PLAYER_MIME=
	PLAYER_EXTENSIONS=
	PLAYER_PACKAGE=
	while IFS='=' read -r key value; do
		case "$key" in
			id) PLAYER_ID="$value" ;;
			name) PLAYER_NAME="$value" ;;
			command) PLAYER_COMMAND="$value" ;;
			mime) PLAYER_MIME="$value" ;;
			extensions) PLAYER_EXTENSIONS="$value" ;;
			package) PLAYER_PACKAGE="$value" ;;
		esac
	done < "$file"
}

custom_for_codec() {
	local wanted="$1"
	CUSTOM_COMMAND=
	CUSTOM_MIME=
	CUSTOM_EXTENSIONS=
	find_custom() {
		local section="$1"
		local codec command mime extensions enabled
		config_get codec "$section" codec
		[ "$codec" = "$wanted" ] || return 0
		config_get_bool enabled "$section" enabled 1
		[ "$enabled" -eq 1 ] || return 0
		config_get command "$section" command
		config_get mime "$section" mime
		config_get extensions "$section" extensions
		CUSTOM_COMMAND="$command"
		CUSTOM_MIME="$mime"
		CUSTOM_EXTENSIONS="$extensions"
	}
	config_foreach find_custom player
}

list_players() {
	local file
	for file in "$PLAYER_DIR"/*.conf; do
		[ -f "$file" ] || continue
		read_descriptor "$file"
		[ -n "$PLAYER_ID" ] || continue
		custom_for_codec "$PLAYER_ID"
		if [ -n "$CUSTOM_COMMAND" ]; then
			printf '%s\t%s\tcustom\t%s\t%s\n' "$PLAYER_ID" "$PLAYER_NAME" "$CUSTOM_COMMAND" "$PLAYER_COMMAND"
		else
			printf '%s\t%s\tauto\t%s\t-\n' "$PLAYER_ID" "$PLAYER_NAME" "$PLAYER_COMMAND"
		fi
	done
}

write_state() {
	local state="$1" codec="$2" uri="$3" player="$4"
	cat > "$RUNTIME_DIR/state" <<EOF
state=$state
codec=$codec
uri=$uri
player=$player
updated=$(date +%s)
EOF
}

show_status() {
	if [ -f "$RUNTIME_DIR/state" ]; then
		cat "$RUNTIME_DIR/state"
	else
		printf 'state=stopped\n'
	fi
}

daemon() {
	write_state stopped '' '' ''
	# Protocol transport will replace this idle process once the native
	# AVTransport/ConnectionManager implementation lands.
	while :; do sleep 3600; done
}

load_main
case "$1" in
	list-players) list_players ;;
	status) show_status ;;
	daemon) daemon ;;
	*) echo "usage: $0 {list-players|status|daemon}" >&2; exit 2 ;;
esac
