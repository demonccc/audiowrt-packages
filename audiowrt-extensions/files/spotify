#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

case "${1:-}" in
	configure)
		/usr/libexec/audiowrt/extensions/configure-settings librespot main /usr/share/audiowrt/extensions/spotify.settings
		/etc/init.d/librespot enabled || /etc/init.d/librespot enable
		/etc/init.d/librespot restart >/dev/null 2>&1 || true
		;;
	disable)
		/etc/init.d/librespot stop >/dev/null 2>&1 || true
		/etc/init.d/librespot disable >/dev/null 2>&1 || true
		;;
	*) echo "Usage: $0 {configure|disable}" >&2; exit 2 ;;
esac
