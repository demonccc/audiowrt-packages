#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

case "${1:-}" in
	configure)
		mkdir -p /tmp/mpd/playlists /tmp/mpd/music
		chown -R mpd:mpd /tmp/mpd 2>/dev/null || true
		candidate=$(mktemp /tmp/mpd/config.XXXXXX)
		trap 'rm -f "$candidate"' EXIT
		cp /usr/share/audiowrt/extensions/mpd.conf "$candidate"
		if ! cmp -s "$candidate" /etc/mpd.conf; then
			cp "$candidate" /etc/mpd.conf
		fi
		/etc/init.d/mpd enabled || /etc/init.d/mpd enable >/dev/null 2>&1 || true
		/etc/init.d/mpd restart >/dev/null 2>&1 || true
		;;
	disable)
		/etc/init.d/mpd stop >/dev/null 2>&1 || true
		/etc/init.d/mpd disable >/dev/null 2>&1 || true
		;;
	*) echo "Usage: $0 {configure|disable}" >&2; exit 2 ;;
esac
